# ==============================================================================
# BETOCH MARKETPLACE — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy to .env for local development: cp .env.example .env
# ==============================================================================

# Server & Runtime
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Database (PostgreSQL 18)
DATABASE_URL=postgresql://betoch_admin@localhost:5433/betoch_dev
DB_MAX_CONNECTIONS=20
DB_TIMEOUT_MS=10000

# Cryptography & Security
# Generate secure 64-character secrets for production using: openssl rand -hex 32
JWT_SECRET=super-secret-jwt-key-change-in-production-min-32-chars-long!
JWT_REFRESH_SECRET=super-secret-refresh-key-change-in-production-min-32-chars!
COOKIE_SECRET=super-secret-cookie-signing-key-change-in-production-32-chars!
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# File Storage Configuration
# Options: 'local' (development) | 's3' (AWS / DigitalOcean Spaces)
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_DOC_TYPES=application/pdf,image/jpeg,image/png

# Telebirr Payment Gateway Configuration (Ethio Telecom)
# Supports live credentials or MOCK sandbox mode
TELEBIRR_ENABLED=true
TELEBIRR_MODE=mock # 'live' | 'mock'
TELEBIRR_API_URL=https://app.ethiomobilemoney.et:2121/ammapi/payment/service-open/
TELEBIRR_APP_ID=mock_telebirr_app_id
TELEBIRR_APP_KEY=mock_telebirr_app_key
TELEBIRR_SHORT_CODE=100100
TELEBIRR_NOTIFY_URL=http://localhost:4000/api/v1/payments/telebirr/webhook
TELEBIRR_RETURN_URL=http://localhost:5173/payments/success
TELEBIRR_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMOCK_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----"
TELEBIRR_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMOCK_PUBLIC_KEY\n-----END PUBLIC KEY-----"

# Platform Business Rules
DEFAULT_COMMISSION_PERCENT=10.00
MAX_DEPOSIT_MONTHS=2

# Observability (GitHub Student Pack / Sentry)
SENTRY_DSN=
LOG_LEVEL=info

# Frontend Configuration
VITE_API_URL=http://localhost:4000/api/v1
